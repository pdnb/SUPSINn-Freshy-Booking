APP_NAME="Freshy Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://supsinn-freshy-booking.test

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local default is SQLite. Switch without changing models (ADR-001):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=supsinn_freshy_booking
# DB_USERNAME=root
# DB_PASSWORD=
#
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=supsinn_freshy_booking
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is optional. The app boots with database drivers above.
# To use Redis for cache / queue / session:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local admin seed only — change before any shared/production deploy.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# PromptPay on the payment page. Prefer PROMPTPAY_QR_PAYLOAD (static Bill Payment
# EMV string from the shop QR). Amount is injected as Tag 54 for amount_due_now.
# Without payload, falls back to AnyID from PROMPTPAY_ID (phone or 13-digit national ID).
PROMPTPAY_ID=0000000000
PROMPTPAY_NAME="ศูนย์หนังสือ มรส."
PROMPTPAY_QR_PAYLOAD=

# LINE LIFF (optional). Empty = storefront works as normal browser only.
# Register a LIFF app on the same channel; endpoint URL = this site's origin.
LINE_LIFF_ID=
LINE_CHANNEL_ID=
